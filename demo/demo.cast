[0.400, "o", "\r\u001b[J\u001b[6d    \u001b[36mb2d84f17-90ce-4a3b-8e6f-5d21c7a9e034\u001b[m  \u001b[90m14/11/2026 16:38\u001b[m  \u001b[90m 57.7K\u001b[m    Fix flaky cart tests\r\n\u001b[35;1m▌\u001b[m   \u001b[36me7a03c55-1f2b-4d8e-b6c9-2a4f80d7e1b3\u001b[m  \u001b[90m13/11/2026 17:38\u001b[m  \u001b[90m143.5K\u001b[m  \u001b[1m  Add Stripe webhooks\u001b[m\u001b[22;5Hhandle stripe webhooks for refunds\u001b[K\n\n\u001b[5GAdded `/webhooks/stripe` with signature checks and idempotency keys stored in `webhook_events`.\u001b[K"]
